    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/ssr": "^21.0.0",
    "@gcds-core/components": "file:../../../../gcds-components/packages/web",
    "@gcds-core/components-angular": "file:../../../../gcds-components/packages/angular/dist",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@angular/localize": "^21.2.18",
    "@playwright/test": "1.57.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@types/xml2js": "^0.4.14",
    "angular-eslint": "21.4.0",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-extract-i18n-merge": "^3.4.0",
    "playwright-ng-schematics": "^2.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",

{
  "name": "angular-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "i18n": "ng extract-i18n --format xlf2 --source-file messages.g.xlf --output-path src/locale",
    "i18n:test": "npx http-server -p 8080 -c-1 dist/angular-template/browser",
